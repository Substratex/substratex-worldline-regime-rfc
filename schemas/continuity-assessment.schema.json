{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:worldline-regime:1.0:schema:continuity-assessment",
  "title": "WRS Continuity Assessment",
  "type": "object",
  "required": [
    "wrs_version",
    "assessment_id",
    "worldline_id",
    "horizon",
    "status",
    "evidence_basis",
    "run_boundary",
    "method"
  ],
  "properties": {
    "wrs_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "worldline_id": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "urn:substratex:worldline-regime:1.0:schema:common-defs#/$defs/coordinate"
        },
        "end": {
          "$ref": "urn:substratex:worldline-regime:1.0:schema:common-defs#/$defs/coordinate"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "continuous",
        "discontinuous",
        "conditional",
        "indeterminate"
      ]
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "discontinuities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_boundary": {
      "type": "boolean"
    },
    "method": {
      "type": "object",
      "required": [
        "method_id",
        "version"
      ],
      "properties": {
        "method_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
