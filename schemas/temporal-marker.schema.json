{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:worldline-regime:1.0:schema:temporal-marker",
  "title": "WRS Temporal Marker",
  "type": "object",
  "required": [
    "wrs_version",
    "marker_id",
    "worldline_id",
    "marker_type",
    "coordinate",
    "status",
    "method",
    "evidence_horizon",
    "evidence_refs"
  ],
  "properties": {
    "wrs_version": {
      "const": "1.0"
    },
    "marker_id": {
      "type": "string",
      "minLength": 1
    },
    "worldline_id": {
      "type": "string",
      "minLength": 1
    },
    "marker_type": {
      "enum": [
        "t_aw",
        "t_candidate",
        "t_star",
        "t_f",
        "t_recovery_candidate",
        "t_recovery"
      ]
    },
    "coordinate": {
      "anyOf": [
        {
          "$ref": "urn:substratex:worldline-regime:1.0:schema:common-defs#/$defs/coordinate"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "confirmed",
        "not_supplied",
        "not_observed",
        "unavailable",
        "not_computable",
        "indeterminate"
      ]
    },
    "method": {
      "type": "object",
      "required": [
        "method_id",
        "version"
      ],
      "properties": {
        "method_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_horizon": {
      "anyOf": [
        {
          "$ref": "urn:substratex:worldline-regime:1.0:schema:common-defs#/$defs/coordinate"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualification": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
