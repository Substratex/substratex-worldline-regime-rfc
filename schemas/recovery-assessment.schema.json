{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:worldline-regime:1.0:schema:recovery-assessment",
  "title": "WRS Recovery Assessment",
  "type": "object",
  "required": [
    "wrs_version",
    "assessment_id",
    "worldline_id",
    "status",
    "precursor_state",
    "evidence_refs",
    "method"
  ],
  "properties": {
    "wrs_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "worldline_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "confirmed",
        "partial_recovery",
        "failed_recovery",
        "not_observed",
        "indeterminate"
      ]
    },
    "precursor_state": {
      "type": "string",
      "minLength": 1
    },
    "candidate_marker_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_marker_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "persistence_satisfied": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "re_entry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "assessed": {
          "type": "boolean"
        },
        "correspondence_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "enum": [
            "re_entry",
            "new_formation",
            "indeterminate",
            "not_assessed"
          ]
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "method_id",
        "version"
      ],
      "properties": {
        "method_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
