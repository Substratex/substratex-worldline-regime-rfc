{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:worldline-regime:1.0:schema:regime-classification-contract",
  "title": "WRS Regime Classification Contract",
  "type": "object",
  "required": [
    "wrs_version",
    "contract_id",
    "version",
    "required_signals",
    "eligible_horizon",
    "persistence",
    "hysteresis",
    "missingness_behavior",
    "permitted_regimes",
    "forbidden_interpretations"
  ],
  "properties": {
    "wrs_version": {
      "const": "1.0"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "required_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "eligible_horizon": {
      "type": "string",
      "minLength": 1
    },
    "thresholds": {
      "type": "object"
    },
    "persistence": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "minimum_observations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "hysteresis": {
      "type": "object",
      "required": [
        "used"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "entry_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_rule": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "missingness_behavior": {
      "enum": [
        "refuse",
        "conditional",
        "indeterminate"
      ]
    },
    "permitted_regimes": {
      "type": "array",
      "items": {
        "$ref": "urn:substratex:worldline-regime:1.0:schema:common-defs#/$defs/regime"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "candidate_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "forbidden_interpretations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
