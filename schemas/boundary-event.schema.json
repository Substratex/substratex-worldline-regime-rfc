{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:worldline-regime:1.0:schema:boundary-event",
  "title": "WRS Boundary Event",
  "type": "object",
  "required": [
    "wrs_version",
    "boundary_event_id",
    "worldline_id",
    "boundary_type",
    "coordinate",
    "status",
    "evidence_refs",
    "method"
  ],
  "properties": {
    "wrs_version": {
      "const": "1.0"
    },
    "boundary_event_id": {
      "type": "string",
      "minLength": 1
    },
    "worldline_id": {
      "type": "string",
      "minLength": 1
    },
    "boundary_type": {
      "enum": [
        "weakening",
        "candidate_boundary",
        "confirmed_boundary",
        "observable_failure",
        "recovery_candidate",
        "confirmed_recovery",
        "other"
      ]
    },
    "coordinate": {
      "anyOf": [
        {
          "$ref": "urn:substratex:worldline-regime:1.0:schema:common-defs#/$defs/coordinate"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "confirmed",
        "not_observed",
        "not_supplied",
        "indeterminate"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method": {
      "type": "object",
      "required": [
        "method_id",
        "version"
      ],
      "properties": {
        "method_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
